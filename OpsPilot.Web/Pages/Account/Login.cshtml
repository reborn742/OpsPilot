@page
@model OpsPilot.Web.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Sign in";
}

<h1 class="auth-title">Welcome back</h1>
<p class="auth-subtitle">Sign in to your workspace.</p>

<form method="post" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />

    <div asp-validation-summary="ModelOnly" class="auth-error" role="alert"></div>

    <div class="auth-field">
        <label asp-for="Input.Email">Email</label>
        <input asp-for="Input.Email" autocomplete="username" autofocus />
        <span asp-validation-for="Input.Email" class="auth-field-error"></span>
    </div>

    <div class="auth-field">
        <label asp-for="Input.Password">Password</label>
        <input asp-for="Input.Password" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="auth-field-error"></span>
    </div>

    <label class="auth-check">
        <input asp-for="Input.RememberMe" />
        <span>Keep me signed in</span>
    </label>

    <button type="submit" class="auth-button">Sign in</button>
</form>
