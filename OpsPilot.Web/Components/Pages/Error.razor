@page "/Error"
@using System.Diagnostics

<PageTitle>Error | OpsPilot</PageTitle>

<div class="status-page">
    <div class="page-eyebrow">SOMETHING WENT WRONG</div>
    <h1>Unexpected error</h1>
    <p class="page-description">
        The request could not be completed. Please try again, or return to the overview.
    </p>

    @if (ShowRequestId)
    {
        <p class="status-meta">Request ID: <code>@RequestId</code></p>
    }

    <a class="auth-button status-button" href="/">Back to overview</a>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
